      "name": "Configuração",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -1000,
        0
      ],
      "notes": "numerosPermitidos: DDI+DDD+número separados por vírgula. prefixo: palavra que liga o modo app (vazio = toda mensagem vai para o agente).",
      "notesInFlow": true,
      "id": "3df66dea-1f40-4d05-8a42-04736c66c3d1"
    },
    {
      "parameters": {
        "jsCode": "// Filtra a mensagem da Evolution API e extrai o texto.\nconst corpo = $json.body ?? {};\nconst evento = String(corpo.event ?? '').toLowerCase().replace(/_/g, '.');\nif (evento && evento !== 'messages.upsert') return [];\n\nconst dados = Array.isArray(corpo.data) ? corpo.data[0] ?? {} : corpo.data ?? {};\nconst chave = dados.key ?? {};\nif (chave.fromMe) return [];\n\nconst jid = String(chave.remoteJid ?? '');\nif (jid.endsWith('@g.us') || jid.includes('broadcast')) return []; // grupos e status\n\n// Com endereços @lid, o telefone vem em outro campo.\nconst jidTelefone = [chave.senderPn, chave.remoteJidAlt, chave.participantAlt, jid]\n  .map((j) => String(j ?? ''))\n  .find((j) => j.endsWith('@s.whatsapp.net')) ?? '';\nconst telefone = jidTelefone.split('@')[0].replace(/\\D/g, '');\n\n// Celulares do Brasil às vezes chegam sem o nono dígito: compara sem ele.\nconst normalizar = (n) => {\n  const d = String(n).replace(/\\D/g, '');\n  return d.length === 13 && d.startsWith('55') && d[4] === '9' ? d.slice(0, 4) + d.slice(5) : d;\n};\nconst permitidos = String($json.numerosPermitidos ?? '').split(',').map(normalizar).filter(Boolean);\nif (!telefone || !permitidos.includes(normalizar(telefone))) return [];\n\nconst msg = dados.message ?? {};\nlet texto = String(\n  msg.conversation ??\n  msg.extendedTextMessage?.text ??\n  msg.imageMessage?.caption ??\n  msg.videoMessage?.caption ??\n  msg.documentMessage?.caption ??\n  '',\n).trim();\nconst tipo = msg.audioMessage ? 'audio' : 'texto';\n\n// \"Modo app\": como o número é pessoal, só conversa com o agente depois de\n// \"#app\". O modo dura alguns minutos desde a última mensagem ou até \"sair\".\nconst prefixo = String($json.prefixo ?? '').trim().toLowerCase();\nconst duracaoMs = Number($json.minutosModoApp ?? 30) * 60_000;\nconst memoria = $getWorkflowStaticData('global');\nmemoria.modoApp = memoria.modoApp ?? {};\nconst quem = normalizar(telefone);\nconst agora = Date.now();\nlet ativo = prefixo === '' || (memoria.modoApp[quem] ?? 0) > agora;\nif (prefixo && texto.toLowerCase().startsWith(prefixo)) {\n  ativo = true;\n  texto = texto.slice(prefixo.length).trim() || 'ajuda';\n}\nif (!ativo) return [];\nif (tipo === 'texto' && !texto) return [];\n\nconst comando = texto.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[!.?]+$/, '');\nif (comando === 'sair') delete memoria.modoApp[quem];\nelse memoria.modoApp[quem] = agora + duracaoMs;\nconst rapido = ['ajuda', 'menu', 'oi', 'ola', 'link', 'links', 'sair'].includes(comando);\n\nreturn [{\n  json: {\n    responderPara: telefone,\n    nome: dados.pushName ?? '',\n    idMensagem: chave.id ?? '',\n    tipo,\n    texto,\n    rapido,\n    evolutionUrl: String($json.evolutionUrl ?? '').replace(/\\/+$/, ''),\n    instancia: $json.instancia,\n    agenteUrl: String($json.agenteUrl ?? '').replace(/\\/+$/, ''),\n  },\n}];"
      },
