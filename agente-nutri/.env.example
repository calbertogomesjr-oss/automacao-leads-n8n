# Copie para .env e preencha.

# Senha longa que o n8n usa para chamar o agente (gere com: openssl rand -hex 32)
TOKEN=

# Domínio do site e do APK (o DNS precisa apontar para o IP da VPS).
# O Traefik da VPS gera o HTTPS sozinho.
DOMINIO=nutri.stfu.fun
URL_PUBLICA=https://nutri.stfu.fun

# Porta local para testes na VPS (troque se a 3100 já estiver em uso)
PORTA_LOCAL=3100

# Qual agente programa: claude ou codex
AGENTE=claude

# --- Claude (escolha UM) ---
# Assinatura Pro/Max: gere com "claude setup-token" no seu computador
CLAUDE_CODE_OAUTH_TOKEN=
# ou API key da Anthropic (cobrança por uso)
# ANTHROPIC_API_KEY=

# --- Codex (se AGENTE=codex) ---
# OPENAI_API_KEY=

# Opcional: modelo específico (vazio = padrão do agente)
MODELO=

# Limites
LIMITE_DIARIO=30
TEMPO_LIMITE_MIN=15
