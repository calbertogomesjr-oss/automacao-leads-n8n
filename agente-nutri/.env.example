# Copie para .env e preencha.

# Senha longa que o n8n usa para chamar o agente (gere com: openssl rand -hex 32)
TOKEN=

# Endereço público onde o site e o APK ficam (sem barra no final)
URL_PUBLICA=https://nutri.seudominio.com.br

# Qual agente programa: claude ou codex
AGENTE=claude

# --- Claude (escolha UM) ---
# Assinatura Pro/Max: gere com "claude setup-token" no seu computador
CLAUDE_CODE_OAUTH_TOKEN=
# ou API key da Anthropic (cobrança por uso)
# ANTHROPIC_API_KEY=

# --- Codex (se AGENTE=codex) ---
# OPENAI_API_KEY=

# Opcional: modelo específico (vazio = padrão do agente)
MODELO=

# Limites
LIMITE_DIARIO=30
TEMPO_LIMITE_MIN=15
